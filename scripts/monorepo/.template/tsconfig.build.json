{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src/index.ts"],
	"exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
