{
	"name": "polym",
	"private": true,
	"type": "module",
	"module": "index.ts",
	"workspaces": {
		"packages": [
			"packages/*"
		]
	},
	"scripts": {
		"build": "turbo run build --filter='./packages/**'",
		"check": "bun scripts/checks",
		"lint": "oxlint",
		"prepare": "husky",
		"test": "turbo run test --filter='./packages/**'",
		"workspace:clean": "bun scripts/monorepo/clean.ts",
		"workspace:create": "bun scripts/monorepo/create-package.ts",
		"workspace:list": "bun scripts/monorepo/list.ts",
		"workspace:remove": "bun scripts/monorepo/remove-package.ts"
	},
	"dependencies": {
		"colorette": "^2.0.20"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.0",
		"@polym/constants": "workspace:*",
		"@polym/utils": "workspace:*",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"oxlint": "^1.39.0",
		"prettier": "3.7.4",
		"turbo": "^2.7.4"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"packageManager": "bun@1.3.5"
}
